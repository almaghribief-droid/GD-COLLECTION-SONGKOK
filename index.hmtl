<style>
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:Arial,sans-serif;background:#f7f7f1;color:#20372b;line-height:1.7}
header{background:#102d22;color:white;padding:18px 7%;display:flex;justify-content:space-between;align-items:center;flex-wrap:wrap}
.logo{font-size:23px;font-weight:bold;color:#e4c477;letter-spacing:2px}
nav a{color:white;text-decoration:none;margin:8px;font-size:14px}
.hero{background:linear-gradient(135deg,#102d22,#315b40);color:white;text-align:center;padding:85px 7%}
.hero h1{font-size:clamp(30px,5vw,48px);line-height:1.2;margin-bottom:18px}
.hero h1 span,.gold{color:#e4c477}
.hero p{max-width:700px;margin:0 auto 28px;color:#e5e9e5}
.btn{display:inline-block;background:#dfbd69;color:#142d21;padding:13px 25px;border-radius:6px;text-decoration:none;font-weight:bold}
section{padding:65px 8%}
.heading{text-align:center;margin-bottom:35px}
.heading h2{font-size:29px;color:#173b2a}
.heading p{color:#68756c;margin-top:8px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(220px,1fr));gap:20px}
.card{background:white;padding:25px;border-radius:12px;border:1px solid #e5e5da;box-shadow:0 5px 18px #00000008}
.card h3{color:#24543a;margin-bottom:10px}
.symbol{font-size:35px;margin-bottom:12px}
.about{background:#e9ede4}
.gallery-card{background:#173b2a;color:white;border-radius:12px;padding:30px;text-align:center;min-height:150px;display:flex;flex-direction:column;justify-content:center}
.gallery-card strong{color:#e4c477;font-size:20px}
.cta{background:#102d22;color:white;text-align:center}
.cta h2{font-size:30px;color:#e4c477;margin-bottom:12px}
.cta p{margin-bottom:25px}
footer{background:#091d18;color:#cbd4cc;text-align:center;padding:25px;font-size:13px}
@media(max-width:600px){
header{justify-content:center;gap:12px}
nav{text-align:center}
nav a{margin:5px;font-size:12px}
.hero{padding:65px 6%}
section{padding:48px 6%}
}
</style>
</head>
